# KALSHI_ENV selects demo or production. Never commit secrets.
KALSHI_ENV=production
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_BASE64=
# KALSHI_KEY_TYPE=ed25519 (recommended) or rsa; auto-detected from PEM when omitted
# Optional explicit URL override:
# KALSHI_BASE_URL=https://external-api.demo.kalshi.co/trade-api/v2
# Trading safety caps
KALSHI_MAX_ORDER_CONTRACTS=100
KALSHI_MAX_ORDER_CENTS=100
KALSHI_DAILY_CONTRACT_LIMIT=1000
KALSHI_MIN_CASH_CENTS=0
